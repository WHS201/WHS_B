# docker compose 용 환경변수. `cp .env.docker.example .env` 후 값 채우기.
# 이 파일(.env)은 커밋 금지 — 루트 .gitignore 의 `.env` 규칙으로 무시됨.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=whs
MYSQL_USER=whs
MYSQL_PASSWORD=change-me

# --- 백엔드 시크릿 (배포 전 실제 값으로) ---
SECRET_KEY=
JWT_SECRET_KEY=
SOCIAL_SIGNUP_TOKEN_SECRET=
TURNSTILE_SECRET_KEY=

# --- OAuth (백엔드) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# --- FSS 상품 동기화 ---
FSS_API_KEY=

# --- 프론트엔드 빌드타임 (vite import.meta.env.VITE_*) ---
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_REST_API_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- 포트 ---
FRONTEND_PORT=8080
